{
  "name": "hydrocalc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src e2e scripts *.ts *.json index.html README.md downloads/README.md",
    "format": "prettier --write src e2e scripts *.ts *.json index.html README.md downloads/README.md",
    "build:offline": "tsc -b && vite build --mode offline --config vite.offline.config.ts && node scripts/package-offline.mjs",
    "test:offline": "playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "ml-fcnnls": "3.1.0",
    "ml-matrix": "^6.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
